   "source": [
    "bill = float(input(\"What is the total amount of the bill? \"))\n",
    "tip_percent = float(input(\"What percentage would you like to tip? \"))\n",
    "\n",
    "# Calculate the tip\n",
    "tip_amount = bill * (tip_percent / 100)\n",
    "total_bill = bill + tip_amount\n",
    "\n",
    "print(f\"The total, including tip, is: ${total_bill:.2f}\")"
   ]
